FROM stereolabs/zed:5.2.2-gl-devel-cuda12.8-ubuntu24.04

WORKDIR /app

# Install build tools (cmake + compiler) and any extra deps you need.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libopencv-dev \
    && rm -rf /var/lib/apt/lists/*

CMD ["bash"]
